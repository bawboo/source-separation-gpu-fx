+    require(roformerWorker.existsAsFile(), "RoFormer worker script is missing");
+    _wputenv_s(L"HTFX_USE_FAKE_WORKER", L"");
+    _wputenv_s(L"HTFX_ROFORMER_PYTHON", roformerPython.getFullPathName().toWideCharPointer());
