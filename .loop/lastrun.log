+                       state == HTDemucsGpuFXAudioProcessor::SeparationState::error;
+            },
+            std::chrono::seconds(60)),
+        "RoFormer C++ route timed out");
+    require(processor.hasPreview(), "RoFormer C++ route produced no preview");
+}
