        const auto candidate = root.getChildFile(relativePath);
        if (candidate.isDirectory()) {
            return utf8Path(candidate.getFullPathName());
        }
    }
    return utf8Path(sidecarRoots.front().getChildFile(relativePath).getFullPathName());
}

