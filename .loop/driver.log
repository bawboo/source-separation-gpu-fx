+                                          : " [Audited]");
+            roformerModelBox_.addItem(
+                displayName, roformerModelBox_.getNumItems() + 1);
+            visibleRoformerIds_.push_back(model.id);
+            if (model.id == selectedId) {
+                selectedIndex = roformerModelBox_.getNumItems() - 1;
