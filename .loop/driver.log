+        const auto category = roformerCategoryBox_.getSelectedItemIndex() <= 0
+                                  ? juce::String{}
+                                  : roformerCategoryBox_.getText();
+        const auto search = roformerSearch_.getText().trim();
+
+        roformerModelBox_.clear(juce::dontSendNotification);
