+                    static_cast<bool>(object->getProperty("experimental"));
+                if (model.id.isNotEmpty()) {
+                    loaded.push_back(std::move(model));
+                }
+            }
+        }
+    }
+    const std::scoped_lock lock(roformerMutex_);
+    roformerModels_ = std::move(loaded);
+}
