* text=auto
*.cpp text eol=lf
*.h text eol=lf
*.py text eol=lf
# A CRLF in a shebang line makes the kernel look for an interpreter named
# "bash\r", so the macOS build scripts must never be checked out with them.
*.sh text eol=lf
*.md text eol=lf
*.json text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.ps1 text eol=crlf
*.cmd text eol=crlf
*.iss text eol=crlf
*.png binary
*.ico binary
*.patch text eol=lf whitespace=-blank-at-eol,-blank-at-eof
